# ==============================================================================
# JobOS Production & Development Environment Configuration (.env.example)
# Copy this file to .env and configure local secrets
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (Local-first SQLite with WAL mode)
JOBOS_DB_PATH=./data/jobos.db

# Master Encryption Key for Candidate Vault & Secrets (32-byte hex string)
# Leave blank to auto-generate a secure local key in data/.vault_key
JOBOS_VAULT_KEY=

# Google Gemini API Key (Optional: Falls back to deterministic local mock if empty)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AI Safety Limits & Budget Protection Defaults
JOBOS_DEFAULT_TOKEN_LIMIT=100000
JOBOS_WARNING_THRESHOLD_PCT=80
JOBOS_HARD_STOP_THRESHOLD_PCT=100
JOBOS_PERIOD_TYPE=MONTHLY
JOBOS_DEFAULT_COST_CAP_USD=5.00
